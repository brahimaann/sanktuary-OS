# Copy to .env and fill in. Never commit .env.
# Clerk dashboard -> API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
SITE_ORIGINS=https://sanktuary.studio,https://www.sanktuary.studio,https://boroma.tailab8c2c.ts.net,http://localhost:3001

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> the long token
TUNNEL_TOKEN=

# YouTube (optional): Google Cloud console -> APIs & Services -> enable "YouTube Data API v3" ->
# Credentials -> OAuth client ID (Web application), authorised redirect URI:
#   https://sanktuary.studio/api/youtube/callback
# Then connect the channel once in Admin Panel > Front page > YouTube.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailing list (optional): resend.com -> verify the sanktuary.studio domain -> API key.
# MAIL_FROM must use that domain. Then fill in the postal address in Admin Panel > Mailing list.
RESEND_API_KEY=
MAIL_FROM=Sanktuary <hello@sanktuary.studio>
